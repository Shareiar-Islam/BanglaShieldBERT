)\nfor i, k in enumerate(GROQ_API_KEYS, 1):\n    print(f\"key {i}: {k[:6]}...{k[-4:]}\")\n# --- generation settings: DO NOT CHANGE MID-DATASET -----------\n# These must match whatever parts 1-60 used, otherwise you introduce\n# a distribution shift between parts of your own dataset.\nMODEL_NAME            = \"openai/gpt-oss-120b\"\nMODEL_MAX_TOKENS      = 2500     # self-imposed prompt+output budget\nDEFAULT_OUTPUT_TOKENS = 1000     # reserved for the model's reply\nSAFETY_MARGIN_TOKENS  = 32\nMAX_COMPLETION_TOKENS = 1024\nTEMPERATURE           = 1.0\nTOP_P                 = 0.8\nREASONING_EFFORT      = None     # None = same as parts 1-60.\n                                 # \"low\" frees up output budget but CHANGES the\n                                 # output distribution — only switch if you plan\n                                 # to regenerate parts 1-60 too.\n\n# --- pacing ---------------------------------------------------\n# Free tier gpt-oss-120b is roughly 8K tokens/min, so ~1 request per\n# 17s. Lower this only on the dev tier.\nBASE_DELAY_SEC = 15\nMAX_DELAY_SEC  = 180\nMAX_RETRIES    = 8\n\n# --- quality gates --------------------------------------------\nMIN_BANGLA_RATIO = 0.85   # share of letters that must be Bengali script\nMIN_BODY_WORDS   = 30     # shorter than this is treated as a failed generation\nMAX_TITLE_WORDS  = 30     # longer than this means line 1 was not a headline\n\n# --- io -------------------------------------------------------\nWORKING_DIR   = \"/kaggle/working\"\nSAVE_EVERY    = 20        # rows between full Excel writes (JSONL is per-row)\nRETRY_FAILURES = True     # re-attempt rows that previously failed validation\n\nprint(f\"Config loaded — part {FILE_NUM}, {len([k for k in GROQ_API_KEYS if k])} key(s)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-19T19:59:15.335302Z","iopub.execute_input":"2026-09-19T19:59:15.335881Z","iopub.status.idle":"2026-09-19T19:59:16.368113Z","shell.execute_reply.started":"2026-09-19T19:59:15.335847Z","shell.execute_reply":"2026-09-19T19:59:16.36696Z"}},"outputs":[{"name":"stdout","text":"key 1: gsk_5d...xR2a\nkey 2: gsk_Rk...6WJX\nkey 3: gsk_jW...2jM1\nkey 4: gsk_U7...qMOO\nkey 5: gsk_Nh...rwNd\nkey 6: gsk_mW...hRZQ\nkey 7: gsk_wS...VXc0\nConfig loaded — part 81, 7 key(s)\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# ============================================================\n# CELL 2 — IMPORTS, PATHS, VALIDATION HELPERS\n# ============================================================\n!pip install -q groq pandas openpyxl tqdm tiktoken\n\nimport os, re, json, time, unicodedata\nfrom datetime import datetime, timezone\n\nimport pandas as pd\nimport tiktoken\nfrom tqdm.auto import tqdm\n\nenc = tiktoken.get_encoding(\"cl100k_base\")   # approximation only — see note below\n\ndef count_tokens(text: str) -> int:\n    \"\"\"Approximate token count.\n\n    cl100k_base is NOT gpt-oss's tokenizer and over-counts Bangla, so this\n    over-estimates. Kept deliberately: parts 1-60 were budgeted with the same\n    function, and consistency matters more than accuracy here.\n    \"\"\"\n    if not text:\n        return 0\n    return len(enc.encode(text))\n\n\n# ---------- file discovery ----------\ndef find_input_file(part_num: int) -> str:\n    target = f\"news_part_{part_num}.xlsx\"\n    for path in (f\"/kaggle/input/{DATASET_SLUG}/{target}\",\n                 f\"/kaggle/input/{target}\"):\n        if os.path.exists(path):\n            return path\n    if os.path.exists(\"/kaggle/input\"):\n        for root, _, files in os.walk(\"/kaggle/input\"):\n            if target in files:\n                return os.path.join(root, target)\n    raise FileNotFoundError(\n        f\"Could not find '{target}' under /kaggle/input/. \"\n        f\"Add the dataset via + Add Input in the sidebar.\"\n    )\n\n\nINPUT_PATH  = find_input_file(FILE_NUM)\nOUTPUT_PATH = os.path.join(WORKING_DIR, f\"ai_real_part_{FILE_NUM}.xlsx\")\nJSONL_PATH  = os.path.join(WORKING_DIR, f\"ai_real_part_{FILE_NUM}.jsonl\")\n\n\n# ---------- output validation ----------\nBENGALI_RANGE = (0x0980, 0x09FF)\n\ndef bangla_ratio(text: str) -> float:\n    \"\"\"Share of alphabetic characters that fall in the Bengali Unicode block.\n\n    Digits, punctuation and whitespace are ignored, so '২০২৪ সালে' scores 1.0\n    while 'ঢাকায় protest হয়েছে' scores well below it.\n    \"\"\"\n    letters = [ch for ch in text if ch.isalpha()]\n    if not letters:\n        return 0.0\n    bengali = sum(1 for ch in letters\n                  if BENGALI_RANGE[0] <= ord(ch) <= BENGALI_RANGE[1])\n    return bengali / len(letters)\n\n\nLABEL_PREFIXES = (\"শিরোনাম:\", \"সংবাদ:\", \"প্রতিবেদন:\", \"Headline:\", \"Body:\", \"Title:\", \"News:\")\n\ndef clean_line(line: str) -> str:\n    \"\"\"Strip markdown and label prefixes.\n\n    Order matters: '**শিরোনাম:** রাজশাহীতে...' leaves a stray '**' behind if you\n    remove the prefix before the emphasis markers, so emphasis goes first and the\n    prefix pass loops (a label can sit behind a bullet behind a bold marker).\n    \"\"\"\n    line = line.strip()\n    line = re.sub(r\"[*_`]+\", \"\", line)              # markdown emphasis anywhere\n    line = re.sub(r\"^[#>\\-\\u2022\\s]+\", \"\", line)    # headers, bullets, dashes\n    for _ in range(3):\n        stripped = False\n        for p in LABEL_PREFIXES:\n            if line.startswith(p):\n                line = line[len(p):].strip()\n                stripped = True\n        if not stripped:\n            break\n    return line.strip()\n\n\ndef parse_output(raw: str):\n    \"\"\"Split the model reply into (headline, body). Returns ('', '') if unusable.\"\"\"\n    lines = [clean_line(l) for l in raw.splitlines()]\n    lines = [l for l in lines if l and l not in LABEL_PREFIXES]\n    if not lines:\n        return \"\", \"\"\n    title = lines[0]\n    body  = \"\\n\".join(lines[1:]).strip()\n    return title, body\n\n\ndef validate(title: str, body: str, finish_reason: str) -> str:\n    \"\"\"Return 'ok' or a short failure code. Failure codes are retried later.\"\"\"\n    if not title or not body:\n        return \"empty\"\n    if finish_reason == \"length\":\n        return \"cut_off\"\n    if len(body.split()) < MIN_BODY_WORDS:\n        return \"too_short\"\n    if len(title.split()) > MAX_TITLE_WORDS:\n        return \"bad_title\"\n    if bangla_ratio(title + \" \" + body) < MIN_BANGLA_RATIO:\n        return \"low_bangla\"\n    return \"ok\"\n\n\n# ---------- crash-safe saving ----------\ndef atomic_to_excel(df: pd.DataFrame, path: str):\n    \"\"\"Write to a temp file, then rename. A crash mid-write leaves the old file intact.\"\"\"\n    base, ext = os.path.splitext(path)     # keep .xlsx so pandas picks the right engine\n    tmp = f\"{base}.tmp{ext}\"\n    df.to_excel(tmp, index=False)\n    os.replace(tmp, path)\n\n\ndef append_jsonl(record: dict, path: str = JSONL_PATH):\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        f.write(json.dumps(record, ensure_ascii=False) + \"\\n\")\n\n\nprint(f\"Input : {INPUT_PATH}\")\nprint(f\"Output: {OUTPUT_PATH}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-19T19:59:41.997568Z","iopub.execute_input":"2026-09-19T19:59:41.998385Z","iopub.status.idle":"2026-09-19T19:59:50.406764Z","shell.execute_reply.started":"2026-09-19T19:59:41.998347Z","shell.execute_reply":"2026-09-19T19:59:50.405603Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m143.8/143.8 kB\u001b[0m \u001b[31m4.6 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25hInput : /kaggle/input/datasets/sheikhkhalidazad/news-splti-news-81-100/news_part_81.xlsx\nOutput: /kaggle/working/ai_real_part_81.xlsx\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# ============================================================\n# CELL 3 — CLIENT, KEY ROTATION, GENERATION\n# ============================================================\nfrom groq import Groq\n\nSYSTEM_INSTRUCTION = \"\"\"\nYou are a professional Bangla newspaper reporter.\nRewrite the provided news update into a clean, natural newspaper report in standard Bangla.\nRules:\n1. Write strictly in pure Bangla script. Do NOT output Chinese, English, or foreign characters.\n2. Maintain strict factual fidelity to the original text. Do NOT add unverified facts.\n3. Do NOT include prefix labels like 'শিরোনাম:' or 'সংবাদ:'.\n4. Line 1 MUST be the news headline ONLY.\n5. Line 2 onwards MUST be the news body report ONLY.\n\"\"\"\n\nREQUEST_TIMEOUT = 120.0     # a hung request dies after 2 minutes instead of forever\n\n_keys = [k.strip() for k in GROQ_API_KEYS if k and k.strip()]\nif not _keys:\n    raise ValueError(\"No API keys set in GROQ_API_KEYS (Cell 1).\")\n\n\ndef make_client(key: str) -> Groq:\n    \"\"\"max_retries=0 because generate() already handles retries and key rotation.\"\"\"\n    return Groq(api_key=key, timeout=REQUEST_TIMEOUT, max_retries=0)\n\n\n_key_idx = 0\nclient = make_client(_keys[_key_idx])\ncurrent_delay = BASE_DELAY_SEC\n\n\ndef rotate_key() -> bool:\n    \"\"\"Move to the next key. Returns False when every key is exhausted.\"\"\"\n    global _key_idx, client, current_delay\n    if _key_idx + 1 >= len(_keys):\n        return False\n    _key_idx += 1\n    client = make_client(_keys[_key_idx])\n    current_delay = BASE_DELAY_SEC\n    print(f\"Switched to API key #{_key_idx + 1} of {len(_keys)}\")\n    return True\n\n\ndef truncate_to_budget(content: str, title: str):\n    \"\"\"Trim content on word boundaries so the whole request fits MODEL_MAX_TOKENS.\n\n    Returns (content_to_send, was_truncated).\n    \"\"\"\n    estimated = (count_tokens(SYSTEM_INSTRUCTION) + count_tokens(title)\n                 + count_tokens(content) + DEFAULT_OUTPUT_TOKENS + SAFETY_MARGIN_TOKENS)\n    if estimated <= MODEL_MAX_TOKENS:\n        return content, False\n\n    budget = count_tokens(content) - (estimated - MODEL_MAX_TOKENS) - 10\n    if budget <= 0:\n        return \"\", True\n\n    words, lo, hi, best = content.split(), 0, len(content.split()), \"\"\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        candidate = \" \".join(words[:mid])\n        if count_tokens(candidate) <= budget:\n            best, lo = candidate, mid + 1\n        else:\n            hi = mid - 1\n    return best, True\n\n\ndef generate(title: str, content: str):\n    \"\"\"One API call with retry + key rotation.\n\n    Returns (raw_text, finish_reason). Raises only on unrecoverable failure.\n    \"\"\"\n    global current_delay\n\n    kwargs = dict(\n        model=MODEL_NAME,\n        messages=[\n            {\"role\": \"system\", \"content\": SYSTEM_INSTRUCTION},\n            {\"role\": \"user\",   \"content\": f\"শিরোনাম:\\n{title}\\n\\nসংবাদ:\\n{content}\"},\n        ],\n        max_completion_tokens=MAX_COMPLETION_TOKENS,\n        temperature=TEMPERATURE,\n        top_p=TOP_P,\n    )\n    if REASONING_EFFORT:\n        kwargs[\"reasoning_effort\"] = REASONING_EFFORT\n\n    for attempt in range(MAX_RETRIES):\n        try:\n            resp = client.chat.completions.create(**kwargs)\n            text = resp.choices[0].message.content or \"\"\n            reason = resp.choices[0].finish_reason or \"unknown\"\n\n            if current_delay > BASE_DELAY_SEC:\n                current_delay = max(BASE_DELAY_SEC, current_delay - 5)\n            return text.strip(), reason\n\n        except Exception as e:\n            msg = str(e).lower()\n            is_rate = \"429\" in msg or \"rate\" in msg or \"limit\" in msg or \"quota\" in msg\n            is_transient = (\"timeout\" in msg or \"timed out\" in msg or \"connection\" in msg\n                            or \"apiconnection\" in type(e).__name__.lower()\n                            or \"502\" in msg or \"503\" in msg or \"504\" in msg)\n            daily_gone = \"day\" in msg or \"rpd\" in msg or \"tpd\" in msg\n\n            if not (is_rate or is_transient):\n                raise\n\n            if is_transient:\n                wait = 5 * (attempt + 1)\n                print(f\"  transient error ({type(e).__name__}) — retrying in {wait}s \"\n                      f\"(attempt {attempt + 1}/{MAX_RETRIES})\")\n                time.sleep(wait)\n                continue\n\n            if daily_gone and rotate_key():\n                continue\n\n            current_delay = min(MAX_DELAY_SEC,\n                                30 if current_delay < 30 else current_delay + 30)\n            print(f\"  rate limited — waiting {current_delay}s \"\n                  f\"(attempt {attempt + 1}/{MAX_RETRIES})\")\n            time.sleep(current_delay)\n\n    raise RuntimeError(\"Exhausted retries and API keys.\")\n\n\nprint(f\"Ready — {MODEL_NAME}, {len(_keys)} key(s), \"\n      f\"base delay {BASE_DELAY_SEC}s, timeout {REQUEST_TIMEOUT:.0f}s\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-19T20:00:11.79391Z","iopub.execute_input":"2026-09-19T20:00:11.794586Z","iopub.status.idle":"2026-09-19T20:00:12.822341Z","shell.execute_reply.started":"2026-09-19T20:00:11.794535Z","shell.execute_reply":"2026-09-19T20:00:12.821285Z"}},"outputs":[{"name":"stdout","text":"Ready — openai/gpt-oss-120b, 7 key(s), base delay 15s, timeout 120s\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# ============================================================\n# CELL 3.5 — RESTORE CHECKPOINT\n# Run after every kernel restart, before Cell 4.\n# JSONL is written per row; the xlsx only every SAVE_EVERY rows,\n# so the JSONL is the real record.\n# ============================================================\nimport json, shutil, glob\n\n# --- if the working copy is gone, pull it back from an uploaded backup ---\nif not os.path.exists(JSONL_PATH):\n    found = glob.glob(\"/kaggle/input/**/*.jsonl\", recursive=True)\n    match = [p for p in found if os.path.basename(p