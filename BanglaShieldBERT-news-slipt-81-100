",\n                \"gen_status\", \"finish_reason\", \"gen_model\", \"gen_time_utc\"]:\n        df[col] = df[col].fillna(\"\").astype(object)\n\n    atomic_to_excel(df, OUTPUT_PATH)\n    print(f\"recovered {n} rows -> {OUTPUT_PATH}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-19T20:00:21.818108Z","iopub.execute_input":"2026-09-19T20:00:21.818554Z","iopub.status.idle":"2026-09-19T20:00:24.081107Z","shell.execute_reply.started":"2026-09-19T20:00:21.818502Z","shell.execute_reply":"2026-09-19T20:00:24.079947Z"}},"outputs":[{"name":"stdout","text":"restored backup from /kaggle/input/datasets/shareiarislam/part81-backup/ai_real_part_81.jsonl\nrecovered 185 rows -> /kaggle/working/ai_real_part_81.xlsx\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# ============================================================\n# CELL 4 — MAIN LOOP\n# ============================================================\n\nMETA_COLS = {\n    \"ai_generated_news_title\":   \"\",\n    \"ai_generated_news_content\": \"\",\n    \"gen_status\":                \"\",     # ok / empty / cut_off / low_bangla / error:...\n    \"finish_reason\":             \"\",\n    \"source_truncated\":          False,\n    \"bangla_ratio\":              0.0,\n    \"body_words\":                0,\n    \"gen_model\":                 \"\",\n    \"gen_time_utc\":              \"\",\n}\n\n# resume from checkpoint if one exists\nif os.path.exists(OUTPUT_PATH):\n    df = pd.read_excel(OUTPUT_PATH)\n    print(f\"Resuming from checkpoint — {len(df)} rows\")\nelse:\n    df = pd.read_excel(INPUT_PATH)[[\"news_title\", \"news_content\"]].copy()\n    print(f\"Fresh start — {len(df)} rows\")\n\nfor col, default in META_COLS.items():\n    if col not in df.columns:\n        df[col] = default\n\nRETRYABLE = {\"\", \"empty\", \"cut_off\", \"low_bangla\", \"too_short\", \"bad_title\"}\n\ndef needs_work(row) -> bool:\n    status = str(row.get(\"gen_status\", \"\") or \"\").strip()